# Fedora {{.Version}} Workstation image for the NordVPN desktop E2E tests.
# Generated by build-fedora-image, see test/e2e/README.md.

text
lang en_US.UTF-8
keyboard us
timezone UTC --utc
network --bootproto=dhcp --hostname=nordvpn-e2e
url --mirrorlist="https://mirrors.fedoraproject.org/mirrorlist?repo=fedora-{{.Version}}&arch=x86_64"
repo --name=updates --mirrorlist="https://mirrors.fedoraproject.org/mirrorlist?repo=updates-released-f{{.Version}}&arch=x86_64"

zerombr
clearpart --all --initlabel
autopart
bootloader --timeout=1

rootpw --lock
user --name={{.User}} --password={{.User}} --plaintext --groups=wheel
firstboot --disable
poweroff

%packages
@^workstation-product-environment
gnome-shell-extension-appindicator
openssh-server
%end

%post --erroronfail --log=/root/ks-post.log
set -euxo pipefail

# NordVPN app and GUI
rpm --import https://repo.nordvpn.com/gpg/nordvpn_public.asc
cat > /etc/yum.repos.d/nordvpn.repo <<'EOF'
[nordvpn]
name=NordVPN
baseurl=https://repo.nordvpn.com/yum/nordvpn/centos/$basearch
enabled=1
gpgcheck=1
gpgkey=https://repo.nordvpn.com/gpg/nordvpn_public.asc
EOF
dnf install -y nordvpn nordvpn-gui
usermod -aG nordvpn {{.User}}
systemctl enable nordvpnd sshd
# Text mode installs default to the console, boot to the desktop instead
systemctl set-default graphical.target

# SSH access for the test harness, and sudo for test setup
install -d -m 700 -o {{.User}} -g {{.User}} /home/{{.User}}/.ssh
echo '{{.PublicKey}}' > /home/{{.User}}/.ssh/authorized_keys
chown {{.User}}:{{.User}} /home/{{.User}}/.ssh/authorized_keys
chmod 600 /home/{{.User}}/.ssh/authorized_keys
restorecon -R /home/{{.User}}/.ssh
echo '{{.User}} ALL=(ALL) NOPASSWD: ALL' > /etc/sudoers.d/{{.User}}

# Log in to GNOME automatically, skipping the first login setup
cat > /etc/gdm/custom.conf <<'EOF'
[daemon]
AutomaticLoginEnable=True
AutomaticLogin={{.User}}
EOF
install -d -o {{.User}} -g {{.User}} /home/{{.User}}/.config
echo yes > /home/{{.User}}/.config/gnome-initial-setup-done
chown {{.User}}:{{.User}} /home/{{.User}}/.config/gnome-initial-setup-done

# Desktop settings that keep the screen predictable: no animations, screen
# lock, notification banners, welcome tour or update prompts. The tray icon
# needs the AppIndicator extension.
mkdir -p /etc/dconf/profile /etc/dconf/db/local.d
cat > /etc/dconf/profile/user <<'EOF'
user-db:user
system-db:local
EOF
cat > /etc/dconf/db/local.d/00-nordvpn-e2e <<'EOF'
[org/gnome/desktop/interface]
enable-animations=false

[org/gnome/desktop/screensaver]
lock-enabled=false

[org/gnome/desktop/session]
idle-delay=uint32 0

[org/gnome/desktop/notifications]
show-banners=false

[org/gnome/shell]
enabled-extensions=['appindicatorsupport@rgcjonas.gmail.com']
welcome-dialog-last-shown-version='999'

[org/gnome/software]
download-updates=false
allow-updates=false
EOF
dconf update
%end
